{
  "name": "strata",
  "productName": "Strata",
  "version": "0.4.0",
  "description": "Gestor de tareas de escritorio organizado por entornos, proyectos y fases.",
  "main": "./out/main/index.js",
  "desktopName": "strata.desktop",
  "author": "Eduardo Serrano",
  "license": "UNLICENSED",
  "private": true,
  "homepage": "https://github.com/EdsenxX/Strata",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/EdsenxX/Strata.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "build": "npm run typecheck && electron-vite build",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "electron-updater": "^6.8.11",
    "mongoose": "^9.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@milkdown/crepe": "^7.23.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "lucide-react": "^1.72.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "zustand": "^5.1.0"
  }
}
